TECH_AI_MODEL_MANIFEST_PATH=configs/models/tech3-v3.json
TECH_AI_RETRIEVAL_LIMIT=4
TECH_AI_MAX_RETRIEVAL_DISTANCE=0.55
TECH_AI_MAX_SOURCE_CHARACTERS=2000
TECH_AI_MAX_NEW_TOKENS=384
TECH_AI_REPETITION_PENALTY=1.1
TECH_AI_NO_REPEAT_NGRAM_SIZE=4

# Deve ser o mesmo contrato usado pelo tech-ingestao.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSIONS=384

# Modo local (padrão). O Docker Compose fica no tech-ingestao.
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=medquad_knowledge_minilm_v1

# Para Chroma Cloud, substitua o bloco CHROMA_* acima por este e nunca versione a chave:
# CHROMA_MODE=cloud
# CHROMA_HOST=api.trychroma.com
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_API_KEY=sua-chave
# CHROMA_TENANT=seu-tenant
# CHROMA_DATABASE=fiap-tech-challenge-3
# CHROMA_COLLECTION=medquad_knowledge_minilm_v1
